;; A model with a ^:cgproj overlay, for the overlay test of the parser.

(require '[cg.macros :refer [item->]])
(require '[cg.geo :as geo])

(def simple-buffer-model
  (item-> :parcels
    (geo/buffer 100)
    (geo/simplify 10)))

;; Visual metadata. Keys are the canvas node ids, <model>__<unq-fn>-<n>,
;; where n counts the steps of the thread of the model from 1. Here
;; geo/buffer is step 1 and geo/simplify is step 2.
^:cgproj
{:nodes {"simple-buffer-model__buffer-1"   {:pos [100 100]}
         "simple-buffer-model__simplify-2" {:pos [400 100]}}
 :viewport {:zoom 1.0 :x 0 :y 0}}
