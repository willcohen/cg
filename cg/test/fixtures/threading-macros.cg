;; threading-macros.cg - Demonstrates the CG threading macros.

(require '[cg.macros :refer [item-> coll->]])
(require '[cg.geo :as geo])

(def union-model
  (coll-> :parcels
    (geo/union)))

(def configured-model
  (item-> :parcels
    (geo/buffer 10 {:quad-segs 8})
    {:parallelism 4
     :timeout-ms 10000}))
