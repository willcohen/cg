;; typed-mismatch.cg: fixture for the parser checks.
;;
;; This fixture is intentionally non-conforming. Tests assert the
;; presence of each diagnostic code; they do not assert exact counts
;; so adding new lines here is safe as long as the codes remain
;; present.

(require '[cg.macros :refer [item-> table->]])
(require '[cg.geo :as geo])
(require '[cg.dataset :as ds])

;; :unresolved-op
(def lost (totally/missing 1 2))

;; :op-arity-mismatch (too many)
(def overflow (ds/load-geojson "a" "b" "c"))

;; :type-mismatch (string where number expected)
(def bad-distance
  (item-> :parcels (geo/buffer "ten")))

;; :pipeline-type-mismatch (ds/transform-crs output :dataset → geo/buffer row-in :feature)
(def bad-flow
  (table-> :ds
    (ds/transform-crs "EPSG:2249")
    (geo/buffer 10)))

;; :op-output-mismatch (body terminal returns :feature, declared :number)
(defn ^:op bad-output
  {:outputs {:n {:type :number}}}
  [^:table parcels]
  (item-> :parcels (geo/centroid)))

;; :unknown-predicate via filter-by-column.
;; Threading-body case: dataset is implicit, predicate sits at arg 1.
(def bad-filter-threading
  (table-> :ds
    (ds/filter-by-column :area :starts-with? 10)))
