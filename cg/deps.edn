{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/core.async {:mvn/version "1.10.874-alpha3"}
        org.clojure/tools.logging {:mvn/version "1.3.0"}

        ;; Every dep that pulls dtype-next transitively (tech.resource,
        ;; tech.ml.dataset, tablecloth) excludes it, so the pin below is the
        ;; only coordinate.
        cnuernber/dtype-next {:mvn/version "11.026"}
        techascent/tech.resource {:mvn/version "5.09"
                                  :exclusions [cnuernber/dtype-next]}
        techascent/tech.ml.dataset {:mvn/version "8.024"
                                    :exclusions [cnuernber/dtype-next]}

        org.locationtech.jts/jts-core {:mvn/version "1.20.0"}
        org.locationtech.jts.io/jts-io-common {:mvn/version "1.20.0"}

        net.willcohen/proj {:mvn/version "0.1.0"}

        ;; tools.deps does not read the pom profile that picks the native jar
        ;; of the host, and cg names each one. Without one, gdal uses wasm.
        net.willcohen/gdal {:mvn/version "0.0.1"}
        net.willcohen/gdal-native$darwin-aarch64 {:mvn/version "0.0.1"}
        net.willcohen/gdal-native$linux-amd64 {:mvn/version "0.0.1"}
        net.willcohen/gdal-native$linux-aarch64 {:mvn/version "0.0.1"}

        ;; clj-gdal binds :float32 arguments (OGR_F_SetFieldDateTimeEx), which
        ;; clj-native accepts from 0.0.3.
        net.willcohen/native {:mvn/version "0.0.3"}

        ;; cg.parser.jvm compiles against these. The version matches clj-proj,
        ;; clj-native and clj-gdal (dependency_pins_test). truffle-runtime
        ;; gives the JIT runtime, which needs the GraalVM CE JDK of the flake.
        org.graalvm.polyglot/polyglot     {:mvn/version "25.3.4.1"}
        org.graalvm.js/js-language        {:mvn/version "25.3.4.1"}
        org.graalvm.wasm/wasm-language    {:mvn/version "25.3.4.1"}
        org.graalvm.truffle/truffle-runtime {:mvn/version "25.3.4.1"}

        org.babashka/sci {:mvn/version "0.15.58"}

        com.cnuernber/charred {:mvn/version "1.037"}

        scicloj/tablecloth {:mvn/version "7.029.2"
                            :exclusions [cnuernber/dtype-next]}

        ;; Logging. cg logs through tools.logging to SLF4J and gives a
        ;; consumer no log backend. The :log alias adds one.
        org.slf4j/slf4j-api {:mvn/version "2.0.16"}}

 ;; tools.deps does not pass these to -M or -X runs; each alias and each bb
 ;; task restates --enable-native-access and --sun-misc-unsafe-memory-access.
 :jvm-opts ["--enable-native-access=ALL-UNNAMED"
            "-XX:+HeapDumpOnOutOfMemoryError"
            "-XX:NativeMemoryTracking=detail"
            ;; web-tree-sitter loads as an ES module and needs its exports
            "-Dpolyglot.js.esm-eval-returns-exports=true"]

 :aliases {:dev {}

           ;; bb jar: clojure -T:build jar
           :build {:deps {io.github.clojure/tools.build
                          {:git/tag "v0.10.14" :git/sha "1176afd"}}
                   :ns-default build}
           ;; bb deploy supplies :artifact, because the jar name holds the
           ;; version of package.json. deps-deploy defaults :pom-file to
           ;; ./pom.xml, which tools.build never writes.
           :deploy {:extra-deps {slipset/deps-deploy {:mvn/version "0.2.5"}}
                    :exec-fn deps-deploy.deps-deploy/deploy
                    :exec-args {:installer :remote
                                :sign-releases? false
                                :pom-file "target/classes/META-INF/maven/net.willcohen/cg/pom.xml"}}

           ;; The log backend of the bb tasks that run cg (run, test, repl).
           :log {:extra-deps {ch.qos.logback/logback-classic {:mvn/version "1.5.12"}
                              org.slf4j/jcl-over-slf4j {:mvn/version "2.0.16"}
                              org.slf4j/log4j-over-slf4j {:mvn/version "2.0.16"}}}

           :test {:extra-paths ["test"]
                  :extra-deps {io.github.cognitect-labs/test-runner
                               {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                  :jvm-opts ["--enable-native-access=ALL-UNNAMED"
                             "--sun-misc-unsafe-memory-access=allow"]
                  :main-opts ["-m" "cognitect.test-runner"]
                  :exec-fn cognitect.test-runner.api/test}

           ;; Benchmarks: clojure -M:bench -m cg.bench.<name> [args]
           ;; No :main-opts, so the -m and its args reach the namespace.
           :bench {:extra-paths ["bench"]
                   :jvm-opts ["--enable-native-access=ALL-UNNAMED"
                              "--add-opens=java.base/java.nio=ALL-UNNAMED"
                              "--sun-misc-unsafe-memory-access=allow"
                              "-Xmx6g"]}

           ;; nREPL server: bb repl
           :nrepl {:extra-paths ["test"]
                   :extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}}
                   ;; this allows nrepl to interrupt runaway repl evals
                   :jvm-opts ["-Djdk.attach.allowAttachSelf"
                              "--enable-native-access=ALL-UNNAMED"
                              "--add-opens=java.base/java.nio=ALL-UNNAMED"
                              "--sun-misc-unsafe-memory-access=allow"
                              "-XX:+HeapDumpOnOutOfMemoryError"
                              "-XX:NativeMemoryTracking=detail"]
                   :main-opts ["-m" "nrepl.cmdline" "--port" "7888"]}

           ;; Parser test runner: clojure -M:test-parser
           ;; A minimal classpath: only what cg.parser.jvm needs (Clojure
           ;; and GraalVM polyglot), plus the cognitect test-runner. Runs
           ;; only the parser tests under test/cg/parser.
           :test-parser {:replace-deps
                         {org.clojure/clojure            {:mvn/version "1.12.0"}
                          org.graalvm.polyglot/polyglot  {:mvn/version "25.3.4.1"}
                          org.graalvm.js/js-language     {:mvn/version "25.3.4.1"}
                          org.graalvm.wasm/wasm-language {:mvn/version "25.3.4.1"}
                          org.graalvm.truffle/truffle-runtime {:mvn/version "25.3.4.1"}
                          io.github.cognitect-labs/test-runner
                          {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                         :replace-paths ["src" "test"]
                         :main-opts ["-m" "cognitect.test-runner"
                                     "-d" "test/cg/parser"]}}}
